{
  "name": "masd-field-report",
  "productName": "ModuLaser MASD Field Report",
  "version": "1.0.4",
  "appRevision": "01.00.004",
  "description": "Offline commissioning worksheet for Edwards ModuLaser Modular Aspirating Smoke Detector installations.",
  "author": "Brent",
  "license": "GPL-3.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-app": "node scripts/prepare.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && node scripts/dist.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "net.masdtools.fieldreport",
    "productName": "ModuLaser MASD Field Report",
    "files": [
      "main.js",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MASD Field Report"
    }
  }
}
